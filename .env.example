# ---- Site ----
# Public URL used for canonical tags, sitemap and schema (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://toniwardgriefcoaching.com

# ---- Admin dashboard (/dashboard-4-admin-panel) ----
ADMIN_USERNAME=toni
# Use a long, unique password
ADMIN_PASSWORD=change-me-to-a-long-password
# Random 32+ character string used to sign the login cookie
# (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_SESSION_SECRET=

# ---- Storage (added automatically when you connect the Vercel integrations) ----
# Upstash Redis (Vercel Marketplace -> Upstash for Redis). Either naming works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob (Storage -> Blob) for logo / photo uploads
BLOB_READ_WRITE_TOKEN=

# ---- Optional: email contact-form submissions via Resend ----
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Website <no-reply@toniwardgriefcoaching.com>
